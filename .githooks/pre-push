#!/usr/bin/env bash
# Run the distribution's own gates (CLAUDE.md §4's two halves plus the end-to-end suite)
# before pushing, and one check **only this hook can make**: the kernel commit the gitlink
# points at must already be pushed.
#
# Why it exists: CI only speaks **after** the push. On 2026-09-20 there were two
# "found out only after pushing" incidents --
#   - the gitlink pointed at a kernel commit that existed only locally -> CI failed as a
#     whole at the checkout step (`upload-pack: not our ref`), not one job started;
#   - a kernel workflow file was invalid -> GitHub rejected the whole run in 0 seconds and
#     six rounds of CI were fake.
# The first is step three below; the second turns red in local `go test` (tools/ciyaml).
#
# Install it (once per clone; git will not do it for you):
#
#	git config core.hooksPath .githooks
#
# Bypass: `git push --no-verify`. That door is **left open on purpose** -- when the hook
# itself is broken (this machine has no python3 for the fake upstream) it must not trap anyone.
set -euo pipefail

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
    *) have_content=1 ;;
  esac
done
[ -n "${have_content:-}" ] || exit 0

root=$(git rev-parse --show-toplevel)
cd "$root"
step() { printf '\n── %s\n' "$1"; }

step "core-test: the kernel's entire internal test suite (the dependency this distribution carries)"
(cd core && GOPROXY=off go test ./... && make check-fmt && make check-generate && go vet ./...)

step "dist-test: the distribution's own"
if fmt=$(gofmt -l .) && [ -n "$fmt" ]; then
  echo "bad formatting (run gofmt -w):" >&2
  echo "$fmt" >&2
  exit 1
fi
go vet ./...
go run ./tools/distgen -check
# -race matches CI's flag (see ci.yml): a concurrency bug usually looks fine until the
# machine is under load, and finding out after the push means nothing was stopped.
go test -race ./...

step "is the kernel commit the gitlink points at on the remote?"
core_head=$(git -C core rev-parse HEAD)
if [ -z "$(git -C core for-each-ref --contains "$core_head" --format='%(refname)' refs/remotes/)" ]; then
  {
    echo "core/'s HEAD ${core_head:0:7} is not on any **fetched** remote branch."
    echo "Push it first (git -C core push origin main), or CI fails as a whole at the checkout step."
    echo "(It may also just be an unfetched local: try git -C core fetch and run again.)"
  } >&2
  exit 1
fi
echo "ok: ${core_head:0:7} is on the remote"

step "end to end (real binary + the kernel's fake upstream, zero tokens)"
build/build.sh dist >/dev/null
bash mock/e2e_claude_dist.sh
# The browser's write path (snapshot / save / conflict / the two gates): shares the same
# artifact as the check above and needs no fake upstream, so it is cheap.
bash mock/e2e_dashboard.sh
# The install path when no client is installed (fake npm): no network, installs nothing,
# purely local. It is worth more locally -- it judges code reachable only when **this
# machine lacks that tool**, and a dev box usually has codex, so a casual run never
# exercises it (the sandbox's sealed PATH keeps it out).
bash mock/e2e_install.sh
# The consumer side: `newgate ask` takes one sentence in and gets the body out. Also
# needs the fake upstream, but it is fast.
bash mock/e2e_ask.sh
# Codex's two takeover modes, and the chain that maps Codex's own model names back to
# tiers (including "a new model line takes effect without a restart"). Also needs the
# fake upstream.
bash mock/e2e_codex_modes.sh
# Hermes takeover: config.yaml byte surgery, both usages, the /model list syncing by
# itself (never reverting the user's own choice), and key-by-key restore. Also needs the
# fake upstream.
bash mock/e2e_hermes.sh
# Codex x DeepSeek tool crossing (both directions of the lift/downgrade, the response
# side written back, and the switch actually read). Also needs the fake upstream. It
# locks down the **silent** class of failure: without the lift the model cannot see the
# tools, the request still returns 200 and the body still looks plausible -- only no
# tool_result ever comes back.
bash mock/e2e_codex_tools.sh

# ssh-tunnel: **a real sshd, real keys**. Unlike the checks above it needs a local sshd,
# which CI does not have (so it stays out of CI, same reason as e2e_reasoning_affinity.sh).
# Without sshd it **skips and says so** rather than skipping silently: a silent skip
# leaves "did this run at all" invisible in the output, and its next word is red on
# someone else's machine.
if command -v sshd >/dev/null 2>&1; then
  bash mock/e2e_tunnel.sh
else
  echo "- skipping e2e_tunnel.sh (no sshd on this machine)"
fi

printf '\n+ pre-push all green (core-test / dist-test / gitlink / end-to-end)\n'
